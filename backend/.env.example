NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001

# MongoDB single-node replica set. Replace every example password locally.
MONGO_ROOT_USERNAME=ai_crm_root
MONGO_ROOT_PASSWORD=change_me_mongo_root
MONGO_APP_USERNAME=ai_crm_app
MONGO_APP_PASSWORD=change_me_mongo_app
MONGO_DATABASE=ai_crm
MONGO_URI=mongodb://ai_crm_app:change_me_mongo_app@localhost:27017/ai_crm?authSource=ai_crm&replicaSet=rs0&directConnection=true

# Cache and BullMQ can use separate logical databases while sharing local Redis.
REDIS_URL=redis://localhost:6379/0
JOBS_REDIS_URL=redis://localhost:6379/1
REDIS_KEY_PREFIX=ai-crm:

RABBITMQ_USER=ai_crm
RABBITMQ_PASSWORD=change_me_rabbitmq
RABBITMQ_VHOST=ai-crm
RABBITMQ_URL=amqp://ai_crm:change_me_rabbitmq@localhost:5672/ai-crm
RABBITMQ_QUEUE=ai-crm.events

STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=ai_crm_storage
STORAGE_SECRET_KEY=change_me_storage_secret
STORAGE_BUCKET=crm

# Authentication, authorization, outbox, idempotency and logging defaults.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ABAC_POLICY_CACHE_TTL_SECONDS=60
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
IDEMPOTENCY_TTL_SECONDS=86400
LOG_LEVEL=debug

# AI/vector integration remains external to this four-container Compose stack.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=crm-documents
