{
  "name": "erp-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names BE,FE --prefix-colors cyan,magenta \"yarn workspace @erp/backend dev\" \"yarn workspace @erp/frontend dev\"",
    "dev:backend": "yarn workspace @erp/backend dev",
    "dev:frontend": "yarn workspace @erp/frontend dev",
    "build": "yarn workspace @erp/backend build && yarn workspace @erp/frontend build",
    "lint": "yarn workspace @erp/backend lint && yarn workspace @erp/frontend lint",
    "typecheck": "yarn workspace @erp/backend typecheck && yarn workspace @erp/frontend typecheck",
    "test": "yarn workspace @erp/backend test",
    "docker:config": "docker compose --env-file backend/.env -f backend/docker-compose.yml config",
    "docker:up": "docker compose --env-file backend/.env -f backend/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file backend/.env -f backend/docker-compose.yml down",
    "docker:stop": "docker compose --env-file backend/.env -f backend/docker-compose.yml stop",
    "docker:start": "docker compose --env-file backend/.env -f backend/docker-compose.yml start",
    "docker:logs": "docker compose --env-file backend/.env -f backend/docker-compose.yml logs -f",
    "docker:ps": "docker compose --env-file backend/.env -f backend/docker-compose.yml ps",
    "infra:verify": "node --env-file=backend/.env backend/scripts/verify-infrastructure.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
